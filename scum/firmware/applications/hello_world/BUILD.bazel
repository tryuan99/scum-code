load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "hello_world_main",
    srcs = ["hello_world_main.c"],
    additional_linker_inputs = ["//scum/firmware/build:scum_linker_files"],
    defines = [
        "MODULE_OPTICAL",
        "MODULE_GPIO",
        "MODULE_INIT",
        "MODULE_SCM3C_HW_INTERFACE",
        "MODULE_SYS",
        "MODULE_UART",
    ],
    linkopts = ["-T$(location //scum/firmware/build:scum_linker_files)"],
    target_compatible_with = select({
        "//platform:scum3c": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//scum/firmware/common:scum"],
)
