load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cm0dsasm",
    srcs = ["cm0dsasm.s"],
    target_compatible_with = select({
        "//platform:scum3c": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_library(
    name = "retarget",
    srcs = ["retarget.c"],
    target_compatible_with = select({
        "//platform:scum3c": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_library(
    name = "syscalls",
    srcs = ["syscalls.c"],
    target_compatible_with = select({
        "//platform:scum3c": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_library(
    name = "scum",
    deps = [
        ":cm0dsasm",
        ":retarget",
        ":syscalls",
    ],
)
